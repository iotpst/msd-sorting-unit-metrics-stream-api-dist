{
  "namespace": "CarrierControllerMasterState",
  "name": "main",
  "type": "record",
  "fields": [
    {
      "name": "deviceId",
      "doc": "Hostname of the sending device (RevPi), e.g. \"ivtp20\".",
      "type": "string"
    },
    {
      "name": "sortingUnitKey",
      "doc": "The sorting unit key, e.g. \"P_VET_01\" for RPZ Vetroz.",
      "type": "string"
    },
    {
      "name": "timestamp",
      "doc": "Message timestamp. ISO 8601 Format, e.g. 2025-06-20T17:00:00+02:00.",
      "type": "string"
    },
    {
      "name": "serialNumber",
      "doc": "The serial number of the carrier.",
      "type": "string"
    },
    {
      "name": "groupId",
      "doc": "The group id of the carrier.",
      "type": "int"
    },
    {
      "name": "carrierId",
      "doc": "The carrier id.",
      "type": "int"
    },
    {
      "name": "connected",
      "doc": "True, if updates have been received from the CCM within the last 60 seconds.",
      "type": "boolean"
    },
    {
      "name": "errors",
      "doc": "Errors received from CCM.",
      "type": {
        "type": "array",
        "items": {
          "name": "errors",
          "doc": "",
          "type": "string"
        }
      }
    },
    {
      "name": "infos",
      "doc": "Infos received from CCM.",
      "type": {
        "type": "array",
        "items": {
          "name": "infos",
          "doc": "",
          "type": "string"
        }
      }
    }
  ]
}