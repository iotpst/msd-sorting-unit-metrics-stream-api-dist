{
  "swagger": "2.0",
  "info": {
    "title": "MSD Sorting Unit Metrics Stream API",
    "description": "Exposes metrics of a sorting unit.",
    "contact": {
      "name": "bierier"
    },
    "version": "0.1.0-rc.1"
  },
  "host": "server:8080",
  "basePath": "MQTT",
  "paths": {
    "app.iotp.msd.sorting.unit.metrics.CarrierControllerMaster-state": {
      "get": {
        "summary": "Carrier Controller Master state",
        "description": "Shows the current state of a carrier controller master of the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/CarrierControllerMasterState"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.CarrierControllerSlave-state": {
      "get": {
        "summary": "Carrier Controller Slave state",
        "description": "Shows the current state of a carrier controller slave of the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/CarrierControllerSlaveState"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.CarrierAcceleration-event": {
      "get": {
        "summary": "Accleration metrics of a carrier",
        "description": "Acceleration metrics of a carrier in the sorting unit.",
