    },
    "app.iotp.msd.sorting.unit.metrics.PowerAnalyzer-event": {
      "get": {
        "summary": "Power consumption metrics of the sorting unit",
        "description": "A power analyzer measures the current, voltage, power and energy consumption metrics of the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/PowerAnalyzerEvent"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.RunProfileProcessed-event": {
      "get": {
        "summary": "Result of a RunProfile execution",
        "description": "The motor controller will trigger a profile execution by sending the RunProfile message. When the RunProfile  was executed by the carrier controller slave, a RunProfileProcessed message with the resulting execution state is returned.\n",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/RunProfileProcessedEvent"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      }
    }
