{
  "$schema": "http://json-schema.org/draft-07/schema",
  "definitions": {
    "Int": {
      "type": "integer",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#numbers\">Number @asType integer</a>"
    },
    "DateTime": {
      "type": "string",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#string\">String @format date-time</a>,\nas defined by <a href=\"https://tools.ietf.org/html/rfc3339#section-5.6\">RFC 3339, section 5.6</a>,\nfor example: <code>2014-05-22T10:42:42.542+00:00</code>.",
      "format": "date-time"
    }
  },
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "MAC address of the sending device, e.g. 2EC8957302CA",
      "pattern": "[0-9,A-F]{12}",
      "required": true
    },
    "sortingCenter": {
      "$ref": "sorting-center.json",
      "description": "The sorting center id, e.g. \"HRK\" for BPZ Härkingen\r\nTODO Use sortingLocationKey instead -> clarify with jeanrichardm",
      "required": true
    },
    "sorterNumber": {
      "$ref": "#/definitions/Int",
      "description": "The sorter number (unique for the sorting center).\r\nTODO Use sortingUnitKey & sorterKey instead -> clarify with jeanrichardm",
      "minimum": 1,
      "maximum": 9,
      "required": true
    },
    "timestamp": {
      "$ref": "#/definitions/DateTime",
      "description": "Message timestamp. ISO 8601 Format, e.g. 2025-06-20T17:00:00+02:00",
      "required": true
    },
    "group": {
      "$ref": "#/definitions/Int",
      "description": "The group id of the carrier.",
      "required": true
    },
    "carrier": {
      "$ref": "#/definitions/Int",
      "description": "The carrier id.",
      "required": true
    },
    "position": {
      "$ref": "#/definitions/Int",
      "description": "The position in mm of the CCM on the sorting unit.",
      "required": true
    },
    "sensorId": {
      "$ref": "#/definitions/Int",
      "description": "The sensor id of the acceleration sensor.",
      "required": true
    },
    "force": {
      "$ref": "#/definitions/Int",
      "description": "Force in Newton measured by the chain force sensor.",
      "required": true
    }
  },
  "required": [
    "deviceId",
    "sortingCenter",
    "sorterNumber",
    "timestamp",
    "group",
    "carrier",
    "position",
    "sensorId",
    "force"
  ],
  "additionalProperties": false,
  "$id": "#CarrierChainForceEvent",
  "javaType": "ch.post.app.iotp.msd.sorting.unit.metrics.v1.CarrierChainForceEvent",
  "javaInterfaces": [
    "java.io.Serializable"
  ]
}