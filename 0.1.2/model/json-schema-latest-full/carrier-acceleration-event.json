{
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "MAC address of the sending device, e.g. 2EC8957302CA",
      "pattern": "[0-9,A-F]{12}"
    },
    "sortingCenter": {
      "$ref": "#/definitions/SortingCenter",
      "description": "The sorting center id, e.g. \"HRK\" for BPZ Härkingen\r\nTODO Use sortingLocationKey instead -> clarify with jeanrichardm"
    },
    "sorterNumber": {
      "$ref": "#/definitions/Int",
      "description": "The sorter number (unique for the sorting center).\r\nTODO Use sortingUnitKey & sorterKey instead -> clarify with jeanrichardm",
      "minimum": 1,
      "maximum": 9
    },
    "timestamp": {
      "$ref": "#/definitions/DateTime",
      "description": "Message timestamp. ISO 8601 Format, e.g. 2025-06-20T17:00:00+02:00"
    },
    "group": {
      "$ref": "#/definitions/Int",
      "description": "The group id of the carrier."
    },
    "carrier": {
      "$ref": "#/definitions/Int",
      "description": "The carrier id."
    },
    "position": {
      "$ref": "#/definitions/Int",
      "description": "The position in mm of the CCM on the sorting unit."
    },
    "sensorId": {
      "$ref": "#/definitions/Int",
      "description": "The sensor id of the acceleration sensor."
    },
    "accelerationX": {
      "$ref": "#/definitions/Int",
      "description": "X-axis acceleration in m/s^2."
    },
    "accelerationY": {
      "$ref": "#/definitions/Int",
      "description": "Y-axis acceleration in m/s^2."
    },
    "accelerationZ": {
      "$ref": "#/definitions/Int",
      "description": "Z-axis acceleration in m/s^2."
    },
    "accelerationXMin": {
      "$ref": "#/definitions/Int",
      "description": "X-axis acceleration minimum in m/s^2."
    },
    "accelerationYMin": {
      "$ref": "#/definitions/Int",
      "description": "Y-axis acceleration minimum in m/s^2."
    },
    "accelerationZMin": {
      "$ref": "#/definitions/Int",
      "description": "Z-axis acceleration minimum in m/s^2."
    },
    "accelerationXMax": {
      "$ref": "#/definitions/Int",
      "description": "X-axis acceleration maximum in m/s^2."
    },
    "accelerationYMax": {
      "$ref": "#/definitions/Int",
      "description": "Y-axis acceleration maximum in m/s^2."
    },
    "accelerationZMax": {
      "$ref": "#/definitions/Int",
      "description": "Z-axis acceleration maximum in m/s^2."
    },
    "connected": {
      "type": "boolean",
      "description": "True, if updates have been received from the CCM in the last 60 seconds."
    }
  },
  "required": [
    "deviceId",
    "sortingCenter",
    "sorterNumber",
    "timestamp",
    "group",
    "carrier",
    "position",
    "sensorId",
    "accelerationX",
    "accelerationY",
    "accelerationZ",
    "accelerationXMin",
    "accelerationYMin",
    "accelerationZMin",
    "accelerationXMax",
    "accelerationYMax",
    "accelerationZMax",
    "connected"
  ],
  "additionalProperties": false,
  "$id": "#CarrierAccelerationEvent",
  "$schema": "http://json-schema.org/draft-07/schema",
  "definitions": {
    "SortingCenter": {
      "type": "string",
      "enum": [
        "HRK",
        "VET",
        "CAD",
        "UTZ",
        "PRA"
      ],
      "$id": "#SortingCenter"
    },
    "Int": {
      "type": "integer",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#numbers\">Number @asType integer</a>"
    },
    "DateTime": {
      "type": "string",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#string\">String @format date-time</a>,\nas defined by <a href=\"https://tools.ietf.org/html/rfc3339#section-5.6\">RFC 3339, section 5.6</a>,\nfor example: <code>2014-05-22T10:42:42.542+00:00</code>.",
      "format": "date-time"
    }
  }
}