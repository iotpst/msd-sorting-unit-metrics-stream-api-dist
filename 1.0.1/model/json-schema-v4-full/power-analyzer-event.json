  "required": [
    "deviceId",
    "sortingUnitKey",
    "timestamp",
    "groupId",
    "carrierId",
    "unitId",
    "voltageL1N",
    "voltageL2N",
    "voltageL3N",
    "currentIL1",
    "currentIL2",
    "currentIL3",
    "currentSum",
    "realPowerP1L1N",
    "realPowerP2L2N",
    "realPowerP3L3N",
    "realPowerSum",
    "apparentPowerS1L1N",
    "apparentPowerS2L2N",
    "apparentPowerS3L3N",
    "apparentPowerSum",
    "reactivePowerQ1L1N",
    "reactivePowerQ2L2N",
    "reactivePowerQ3L3N",
    "reactivePowerSum",
    "realEnergyL1",
    "realEnergyL2",
    "realEnergyL3",
    "realEnergySum",
    "apparentEnergyL1",
    "apparentEnergyL2",
    "apparentEnergyL3",
    "apparentEnergySum",
    "reactiveEnergyL1",
    "reactiveEnergyL2",
    "reactiveEnergyL3",
    "reactiveEnergySum"
