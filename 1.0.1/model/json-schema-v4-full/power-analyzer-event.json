    "apparentEnergyL2": {
      "type": "number",
      "description": "Apparent energy L2 in VAh."
    },
    "apparentEnergyL3": {
      "type": "number",
      "description": "Apparent energy L3 in VAh."
    },
    "apparentEnergySum": {
      "type": "number",
      "description": "Total apparent energy in VAh."
    },
    "reactiveEnergyL1": {
      "type": "number",
      "description": "Reactive energy L1 in varh."
    },
    "reactiveEnergyL2": {
      "type": "number",
      "description": "Reactive energy L2 in varh."
    },
    "reactiveEnergyL3": {
      "type": "number",
      "description": "Reactive energy L3 in varh."
    },
    "reactiveEnergySum": {
      "type": "number",
      "description": "Total reactive energy in varh."
    }
