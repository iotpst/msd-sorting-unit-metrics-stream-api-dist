{
  "swagger": "2.0",
  "info": {
    "title": "MSD Sorting Unit Metrics Stream API",
    "description": "Exposes metrics of a sorting unit.",
    "contact": {
      "name": "bierier"
    },
    "version": "1.0.1"
  },
  "host": "server:8080",
  "basePath": "MQTT",
  "paths": {
    "app.iotp.msd.sorting.unit.metrics.CarrierControllerMaster-state": {
      "get": {
        "summary": "Carrier Controller Master state",
        "description": "Shows the current state of a carrier controller master of the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/CarrierControllerMasterState"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      },
      "x-topic-configuration": {
        "Topic": "post/msd/{env}/{deviceId}/metrics/inbound/carrier-controller-master-state"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.CarrierControllerSlave-state": {
      "get": {
        "summary": "Carrier Controller Slave state",
        "description": "Shows the current state of a carrier controller slave of the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/CarrierControllerSlaveState"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      },
      "x-topic-configuration": {
        "Topic": "post/msd/{env}/{deviceId}/metrics/inbound/carrier-controller-slave-state"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.CarrierAcceleration-event": {
      "get": {
        "summary": "Accleration metrics of a carrier",
        "description": "Acceleration metrics of a carrier in the sorting unit.",
        "tags": [
          "app.iotp.msd.sorting.unit.metrics"
        ],
        "responses": {
          "200": {
            "schema": {
              "type": "array",
              "$ref": "#/definitions/CarrierAccelerationEvent"
            }
          }
        }
      },
      "x-data": {
        "confidentiality": "C1",
        "classification": "P0"
      },
      "x-topic-configuration": {
        "Topic": "post/msd/{env}/{deviceId}/metrics/inbound/carrier-acceleration-event"
      }
    },
    "app.iotp.msd.sorting.unit.metrics.CarrierChainForce-event": {
      "get": {
        "summary": "Force measured on chain of carriers",
        "description": "Shows the current force measured in the chain of carriers",
