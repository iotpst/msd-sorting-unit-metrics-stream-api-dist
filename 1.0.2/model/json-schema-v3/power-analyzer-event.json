{
  "$schema": "http://json-schema.org/draft-03/schema#",
  "definitions": {
    "DateTime": {
      "type": "string",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#string\">String @format date-time</a>,\nas defined by <a href=\"https://tools.ietf.org/html/rfc3339#section-5.6\">RFC 3339, section 5.6</a>,\nfor example: <code>2014-05-22T10:42:42.542+00:00</code>.",
      "format": "date-time"
    },
    "Int": {
      "type": "integer",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#numbers\">Number @asType integer</a>"
    }
  },
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "Hostname of the sending device (RevPi), e.g. \"ivtp20\".",
      "pattern": "[0-9,a-f]",
      "required": true
    },
    "sortingUnitKey": {
      "$ref": "sorting-unit.json",
      "description": "The sorting unit key, e.g. \"P_VET_01\" for RPZ Vetroz.",
      "required": true
    },
    "timestamp": {
      "$ref": "#/definitions/DateTime",
      "description": "Message timestamp. ISO 8601 Format, e.g. 2025-06-20T17:00:00+02:00.",
      "required": true
    },
    "unitId": {
      "$ref": "#/definitions/Int",
      "description": "The unit id of the power analyzer.",
      "required": true
    },
    "voltageL1N": {
      "type": "number",
      "description": "Voltage L1-N in volts.",
      "required": true
    },
    "voltageL2N": {
      "type": "number",
      "description": "Voltage L2-N in volts.",
      "required": true
    },
    "voltageL3N": {
      "type": "number",
      "description": "Voltage L3-N in volts.",
      "required": true
    },
    "currentIL1": {
      "type": "number",
      "description": "Current I L1 in amperes.",
      "required": true
    },
    "currentIL2": {
      "type": "number",
      "description": "Current I L2 in amperes.",
      "required": true
    },
    "currentIL3": {
      "type": "number",
      "description": "Current I L3 in amperes.",
      "required": true
    },
    "currentSum": {
      "type": "number",
      "description": "Total current in amperes.",
      "required": true
    },
    "realPowerP1L1N": {
      "type": "number",
      "description": "Active power P1 L1-N in watts.",
      "required": true
    },
    "realPowerP2L2N": {
      "type": "number",
      "description": "Active power P2 L2-N in watts.",
      "required": true
    },
    "realPowerP3L3N": {
      "type": "number",
      "description": "Active power P3 L3-N in watts.",
      "required": true
    },
    "realPowerSum": {
      "type": "number",
      "description": "Total active power in watts.",
      "required": true
    },
    "apparentPowerS1L1N": {
      "type": "number",
      "description": "Apparent power S1 L1-N in VA.",
      "required": true
    },
    "apparentPowerS2L2N": {
      "type": "number",
      "description": "Apparent power S2 L2-N in VA.",
      "required": true
    },
    "apparentPowerS3L3N": {
      "type": "number",
      "description": "Apparent power S3 L3-N in VA.",
      "required": true
    },
    "apparentPowerSum": {
      "type": "number",
      "description": "Total apparent power in VA.",
      "required": true
    },
    "reactivePowerQ1L1N": {
      "type": "number",
      "description": "Reactive power Q1 L1-N in var.",
      "required": true
    },
    "reactivePowerQ2L2N": {
      "type": "number",
      "description": "Reactive power Q2 L2-N in var.",
      "required": true
    },
    "reactivePowerQ3L3N": {
      "type": "number",
      "description": "Reactive power Q3 L3-N in var.",
      "required": true
    },
    "reactivePowerSum": {
      "type": "number",
      "description": "Total reactive power in var.",
      "required": true
    },
    "realEnergyL1": {
      "type": "number",
      "description": "Active energy L1 in Wh.",
      "required": true
    },
    "realEnergyL2": {
      "type": "number",
      "description": "Active energy L2 in Wh.",
      "required": true
    },
    "realEnergyL3": {
      "type": "number",
      "description": "Active energy L3 in Wh.",
      "required": true
    },
    "realEnergySum": {
      "type": "number",
      "description": "Total active energy in Wh.",
      "required": true
    },
    "apparentEnergyL1": {
      "type": "number",
      "description": "Apparent energy L1 in VAh.",
      "required": true
    },
    "apparentEnergyL2": {
      "type": "number",
      "description": "Apparent energy L2 in VAh.",
      "required": true
    },
    "apparentEnergyL3": {
      "type": "number",
      "description": "Apparent energy L3 in VAh.",
      "required": true
    },
    "apparentEnergySum": {
      "type": "number",
      "description": "Total apparent energy in VAh.",
      "required": true
    },
    "reactiveEnergyL1": {
      "type": "number",
      "description": "Reactive energy L1 in varh.",
      "required": true
    },
    "reactiveEnergyL2": {
      "type": "number",
      "description": "Reactive energy L2 in varh.",
      "required": true
    },
    "reactiveEnergyL3": {
      "type": "number",
      "description": "Reactive energy L3 in varh.",
      "required": true
    },
    "reactiveEnergySum": {
      "type": "number",
      "description": "Total reactive energy in varh.",
      "required": true
    }
  },
  "additionalProperties": false,
  "id": "PowerAnalyzerEvent",
  "javaType": "ch.post.app.iotp.msd.sorting.unit.metrics.v1.PowerAnalyzerEvent",
  "javaInterfaces": [
    "java.io.Serializable"
  ]
}