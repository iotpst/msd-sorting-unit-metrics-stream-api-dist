{
  "$schema": "http://json-schema.org/draft-07/schema",
  "definitions": {
    "DateTime": {
      "type": "string",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#string\">String @format date-time</a>,\nas defined by <a href=\"https://tools.ietf.org/html/rfc3339#section-5.6\">RFC 3339, section 5.6</a>,\nfor example: <code>2014-05-22T10:42:42.542+00:00</code>.",
      "format": "date-time"
    },
    "Int": {
      "type": "integer",
      "description": "<a href=\"https://swagger.io/docs/specification/data-models/data-types/#numbers\">Number @asType integer</a>"
    }
  },
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "description": "Hostname of the sending device (RevPi), e.g. \"ivtp20\".",
      "pattern": "[0-9,a-f]",
      "required": true
    },
    "sortingUnitKey": {
      "$ref": "sorting-unit.json",
      "description": "The sorting unit key, e.g. \"P_VET_01\" for RPZ Vetroz",
      "required": true
    },
    "timestamp": {
      "$ref": "#/definitions/DateTime",
      "description": "Message timestamp. ISO 8601 Format, e.g. 2025-06-20T17:00:00+02:00.",
      "required": true
    },
    "groupId": {
      "$ref": "#/definitions/Int",
      "description": "The group id of the carrier.",
      "required": true
    },
    "carrierId": {
      "$ref": "#/definitions/Int",
      "description": "The carrier id.",
      "required": true
    },
    "position": {
      "$ref": "#/definitions/Int",
      "description": "The position in mm of the CCM on the sorting unit.",
      "required": true
    },
    "sensorId": {
      "$ref": "#/definitions/Int",
      "description": "The sensor id of the acceleration sensor.",
      "required": true
    },
    "accelerationX": {
      "type": "number",
      "description": "X-axis acceleration in m/s^2.",
      "required": true
    },
    "accelerationY": {
      "type": "number",
      "description": "Y-axis acceleration in m/s^2.",
      "required": true
    },
    "accelerationZ": {
      "type": "number",
      "description": "Z-axis acceleration in m/s^2.",
      "required": true
    },
    "accelerationXMin": {
      "type": "number",
      "description": "X-axis acceleration minimum in m/s^2.",
      "required": true
    },
    "accelerationYMin": {
      "type": "number",
      "description": "Y-axis acceleration minimum in m/s^2.",
      "required": true
    },
    "accelerationZMin": {
      "type": "number",
      "description": "Z-axis acceleration minimum in m/s^2.",
      "required": true
    },
    "accelerationXMax": {
      "type": "number",
      "description": "X-axis acceleration maximum in m/s^2.",
      "required": true
    },
    "accelerationYMax": {
      "type": "number",
      "description": "Y-axis acceleration maximum in m/s^2.",
      "required": true
    },
    "accelerationZMax": {
      "type": "number",
      "description": "Z-axis acceleration maximum in m/s^2.",
      "required": true
    },
    "sorterSpeed": {
      "$ref": "#/definitions/Int",
      "description": "The current sorter speed in mm/s.",
      "required": true
    },
    "connected": {
      "type": "boolean",
      "description": "True, if updates have been received from the CCM within the last 60 seconds.",
      "required": true
    }
  },
  "required": [
    "deviceId",
    "sortingUnitKey",
    "timestamp",
    "groupId",
    "carrierId",
    "position",
    "sensorId",
    "accelerationX",
    "accelerationY",
    "accelerationZ",
    "accelerationXMin",
    "accelerationYMin",
    "accelerationZMin",
    "accelerationXMax",
    "accelerationYMax",
    "accelerationZMax",
    "sorterSpeed",
    "connected"
  ],
  "additionalProperties": false,
  "$id": "#CarrierAccelerationEvent",
  "javaType": "ch.post.app.iotp.msd.sorting.unit.metrics.v1.CarrierAccelerationEvent",
  "javaInterfaces": [
    "java.io.Serializable"
  ]
}